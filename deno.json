{
    "minimumDependencyAge": {"age": "P1D", "exclude": ["jsr:@velotype/*"]},
    "name": "@velotype/velochart",
    "license": "MIT",
    "version": "0.0.1",
    "exports": {
        ".": "./src/index.ts"
    },
    "publish": {
        "exclude": [
            ".github/",
            "CLAUDE.md",
            "docs/",
            "tests/",
            "showcase/",
            "scripts/"
        ]
    },
    "tasks": {
        "check-jsx": "deno run -A ./scripts/check-jsx-factory.ts",
        "check-baseline": "deno run --allow-read ./scripts/check-baseline.ts",
        "check-html-strings": "deno run --allow-read ./scripts/check-html-strings.ts",
        "size": "deno run --allow-read --allow-write --allow-run --allow-env ./scripts/bundle-size.ts",
        "test": "cd ./tests/ && deno run -A ./bundle.ts && cd .. && deno test --allow-read --allow-net --allow-sys --allow-env --allow-write --allow-run tests/"
    },
    "lint": {
        "rules": {
            "exclude": [
                "jsx-key",
                "verbatim-module-syntax"
            ]
        }
    },
    "compilerOptions": {
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "f",
        "lib": ["dom", "deno.ns", "esnext"]
    },
    "imports": {
        "@astral/astral": "jsr:@astral/astral@^0.5.4",
        "@std/assert": "jsr:@std/assert@^1.0.16",
        "@std/testing": "jsr:@std/testing@^1.0.16",
        "@velotype/veloserver": "jsr:@velotype/veloserver@^0.2.0",
        "@velotype/velodesign": "../velodesign/src/index.ts",
        "@velotype/velotype/jsx-runtime": "jsr:@velotype/velotype@^0.3.1",
        "@velotype/velotype": "jsr:@velotype/velotype@^0.3.1"
    }
}
